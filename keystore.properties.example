# Copy this file to keystore.properties and fill in your own values.
#
# keystore.properties is ignored by Git. Keep it that way. Anyone who has the
# keystore and these four values can publish an update that your users will
# accept as coming from you.
#
# Make the keystore once, with:
#
#   keytool -genkeypair -v -keystore duo-release.jks \
#     -alias duo -keyalg RSA -keysize 4096 -validity 10000
#
# Then keep duo-release.jks somewhere safe and backed up. If you lose it you
# cannot update the app on Google Play under the same listing. Google Play App
# Signing can take over the job, but only if you set it up before the first
# upload.

storeFile=duo-release.jks
storePassword=change-me
keyAlias=duo
keyPassword=change-me

<?xml version="1.0" encoding="utf-8"?>
<!--
    Content may run into a notch or a punch-hole. Only Android 8.1 and later
    know that attribute, so it lives here and older versions simply do without.
-->
<resources>
    <style name="Theme.Duo" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">#FFFFFFFF</item>
        <item name="android:statusBarColor">#FFFFFFFF</item>
        <item name="android:navigationBarColor">#FFFFFFFF</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
</resources>
